{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postmortem-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INCIDENT",
        "class_name": "IncidentState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IncidentState"]
    }
  ],
  "workflows": [
    {
      "name": "postmortem-workflow",
      "binding": "POSTMORTEM_WORKFLOW",
      "class_name": "PostmortemWorkflow"
    }
  ]
}
